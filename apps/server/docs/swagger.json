    "definitions": {
        "protocol.CreateVaultItemRequest": {
            "type": "object",
            "required": [
                "ciphertext",
                "item_nonce",
                "key_salt"
            ],
            "properties": {
                "ciphertext": {
                    "description": "Ciphertext contains the encrypted item data.",
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "item_nonce": {
                    "description": "ItemNonce is the nonce used to encrypt the item.",
