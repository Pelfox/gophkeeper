                    "type": "string"
                }
            }
        },
        "protocol.CreateVaultRequest": {
            "type": "object",
            "required": [
                "encrypted_master_key",
                "encryption_key_size",
                "encryption_memory_cost",
                "encryption_nonce",
                "encryption_parallelism",
                "encryption_salt",
                "encryption_time_cost",
                "name"
            ],
            "properties": {
                "encrypted_master_key": {
                    "description": "EncryptedMasterKey holds an actual encrypted master key. This value is\nsafe to be stored in the database.",
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "encryption_key_size": {
                    "description": "EncryptionKeySize describes the size of the returned byte slice.",
                    "type": "integer"
                },
                "encryption_memory_cost": {
                    "description": "EncryptionMemoryCost describes how much memory should be used.",
                    "type": "integer"
                },
                "encryption_nonce": {
                    "description": "EncryptionNonce holds the raw bytes that were used by the encryption\nalgorithm to encrypt master key.",
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "encryption_parallelism": {
                    "description": "EncryptionParallelism describes how much threads should be used.",
                    "type": "integer"
                },
                "encryption_salt": {
                    "description": "EncryptionSalt holds the raw bytes that were used for the encryption of\nmaster key.",
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "encryption_time_cost": {
                    "description": "EncryptionTimeCost describes amount of passes of the given\nEncryptionMemoryCost.",
                    "type": "integer"
                },
                "name": {
                    "description": "Name is vault's name.",
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 1
                }
            }
        },
        "protocol.CreateVaultResponse": {
            "type": "object",
            "properties": {
                "created_at": {
                    "description": "CreatedAt is a timestamp when this vault was created.",
                    "type": "string"
                },
                "id": {
                    "description": "ID is vault's id.",
                    "type": "string"
                },
                "name": {
                    "description": "Name is vault's name.",
                    "type": "string"
                },
                "updated_at": {
                    "description": "UpdatedAt is a timestamp when this vault was last updated.",
                    "type": "string"
                }
            }
        },
        "protocol.GetVaultItemResponse": {
